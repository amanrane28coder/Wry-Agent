# Copy this file to .env and fill in the FalkorDB Cloud connection details.
FALKORDB_HOST=your-instance.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=replace-me
FALKORDB_SSL=true
FALKORDB_GRAPH=wry_change_impact
WRY_REPOSITORY_PATH=
# Keep false for private/restricted repositories. Set true only when the selected
# repository's metadata is public or otherwise eligible under the hackathon rules.
WRY_ALLOW_REPOSITORY_METADATA_UPLOAD=false

# Optional model-based tool choice. Prompts are sent to this API only when
# this flag is true and OPENAI_API_KEY is set; otherwise routing stays local.
LLM_TOOL_SELECTION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible endpoint, e.g. your organization's approved gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1
